# Functional + perf target (public sandbox; demo credentials are published by the service)
API_BASE_URL=https://restful-booker.herokuapp.com
API_USERNAME=admin
API_PASSWORD=password123

# Contract-test target: any OpenAPI 3 document (URL or file) + its server base URL
CONTRACT_SCHEMA_URL=https://petstore3.swagger.io/api/v3/openapi.json
CONTRACT_BASE_URL=https://petstore3.swagger.io/api/v3
# Property-based examples per operation (lower = faster)
CONTRACT_MAX_EXAMPLES=15

# k6 thresholds (see perf/k6/smoke.js)
K6_P95_MS=1500
K6_ERROR_RATE=0.02
K6_VUS=5
K6_DURATION=30s
